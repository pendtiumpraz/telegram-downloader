{
  "manifest_version": 3,
  "name": "WAN Telegram Downloader",
  "version": "1.0.3",
  "description": "Sidebar pengunduh media Telegram Web: per grup/topik, image/ dan video/ terpisah, tanpa unduhan ganda.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "downloads", "scripting", "tabs", "nativeMessaging"],
  "host_permissions": ["https://web.telegram.org/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "WAN Telegram Downloader" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [
    {
      "matches": ["https://web.telegram.org/*"],
      "js": ["tgcontent.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
